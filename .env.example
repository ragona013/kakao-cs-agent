# 액션 토큰 (aitop100_로 시작) — 대회 페이지 > 문제 풀이 가이드 > 제작 탭 > "나의 API 토큰"
ACTION_TOKEN=
# LLM: Anthropic 전용 (Messages API 직접 호출)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# LLM_TIMEOUT=30
# LLM_MAX_TOKENS=1024
# (선택) 음성 TC 전사용. 없으면 음성은 "고객에게 글로 재확인"으로 처리
OPENAI_API_KEY=
# Jev 라우터는 기본 꺼짐 (LLM_ROUTER=jev 로 켤 수 있으나 모델은 어차피 Anthropic)
# TYPESAFE_API_KEY=
# 카카오디벨로퍼스 > 앱 > 카카오톡 봇 > 봇 인증 토큰
BOT_TOKEN=
# (선택) 웹훅 설정에 커스텀 헤더를 등록했다면 "헤더이름:값"
WEBHOOK_SECRET_HEADER=
# 키 없이 화면만 테스트할 때 1
MOCK_LLM=0
